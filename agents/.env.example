# agents/.env.example — 이 파일을 agents/.env 로 복사해서 값을 채웁니다(.env는 .gitignore에 있어 커밋되지 않습니다).
#   copy agents\.env.example agents\.env      (Windows)
#   cp agents/.env.example agents/.env        (bash)
# 읽는 곳: run_agents.py, pg_agents.mcp_server, pg_agents.langsmith_export, eval/proofread/eval_proofread.py
# 터미널에 이미 설정된 환경변수가 있으면 그 값이 이깁니다(.env가 덮어쓰지 않습니다).
# 아래는 전부 선택입니다. 지우거나 비워 두면 그 기능만 꺼집니다.

# ── LLM 교정 제안·평가 (https://aistudio.google.com/apikey) ─────────────────────
# 없으면 llm 탐지기는 빈 결과를 돌려주고, 평가에서는 LLM 조합이 표에서 빠집니다.
GEMINI_API_KEY=
# 모델. 기본값은 무료 등급이 있는 flash-lite입니다(평가는 API 121회 호출 — 무료 하루 한도 안).
# 분당 한도(429)에 걸리면 Retry-After만큼 기다렸다 최대 4번까지 다시 부릅니다.
PG_LLM_MODEL=gemini-3.5-flash-lite
# 항상 최신 무료 flash-lite를 쓰려면: PG_LLM_MODEL=gemini-flash-lite-latest (평가 재현성은 떨어짐)
# 더 정확한 쪽(유료 과금될 수 있음): PG_LLM_MODEL=gemini-3.5-flash
# 주의: gemini-2.5-* 는 신규 키에 더 이상 제공되지 않습니다(404 no longer available to new users).
# 교정 탐지기 조합: rules(규칙) kiwi_typo(오타 모델) kiwi_space(띄어쓰기 모델) llm
# PG_PROOF_METHODS=rules,kiwi_typo,llm

# ── 추적을 LangSmith로 보내기 (https://smith.langchain.com → Settings → API Keys) ─
# 없으면 pg_agents.langsmith_export가 아무것도 보내지 않습니다.
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=printguard

# ── 로컬 동작 설정(기본값이 있어 비워 둬도 됩니다) ──────────────────────────────
# PG_PYTHON=                # 파이썬 에이전트를 띄울 인터프리터. 비워 두면 run_agents.py를 실행한 그 파이썬입니다.
#                           # 의존성이 깔린 환경 경로를 적어 두면 어느 터미널에서 켜도 같게 뜹니다.
#                           # 예: C:\Users\<나>\miniforge3\envs\dev\python.exe
# PG_MOCK=1               # 목 모드(토큰 mock:<이름>, 사람 토큰 human:<이름>). 0으로 두면 토큰을 직접 넣어야 합니다
# PG_DAILY_LIMIT=1000000    # safety의 하루 누적 금액 한도(원)
# PG_REVIEW_TTL=600         # 사람 승인 대기 기한(초). 지나면 자동 거절
# PG_FAKE_AGENTS=0          # 1이면 부서 에이전트 대신 프로세스 안의 가짜 응답으로 돕니다(시연용)
# PG_DATA_DIR=              # 의뢰 PDF·공통 로그·보고서를 둘 폴더(기본 agents/.data)

# ── 공개 배포(Vercel)에서 이 PC의 에이전트를 부를 때 ─────────────────────────────
# 브라우저가 다른 출처(vercel.app)에서 오케스트레이터를 부르므로 그 출처를 허용한다.
# 비워 두면 로컬(127.0.0.1·localhost)만 허용한다.
PG_CORS_ORIGIN_REGEX=https://print-guard-ai[a-z0-9-]*\.vercel\.app|https://[a-z0-9-]+-2taeyoon1\.vercel\.app|http://(127\.0\.0\.1|localhost):\d+

# 인디자인 원본 수정(DesignCraft MCP). 비워 두면 PATH와 각 OS의 기본 설치 위치를 찾는다.
# designcraft-cli는 에이전트를 돌리는 PC에 있어야 한다 — MCP는 stdio로만 말한다.
PG_DESIGNCRAFT_CLI=
PG_MAX_SOURCE_MB=60
PG_MAX_FIXES=300

# ── 인증(서버가 발급해 서명하는 토큰) ──────────────────────────────────────────
# 비워 두면 agents/.data/auth_secret 에 한 번 만들어 두고 계속 씁니다(권장).
# 직접 넣으면 그 값으로 서명합니다 — 에이전트를 여러 대에 나눠 띄울 때만 필요합니다.
# 이 값(또는 파일)을 바꾸면 발급해 둔 토큰이 **전부** 무효가 됩니다. 그게 회수 수단입니다.
PG_AUTH_SECRET=
# PG_SESSION_HOURS=12          # 브라우저 세션 토큰의 기한(시간)
# PG_MAX_SESSIONS_PER_IP=60    # 한 IP가 1시간에 할 수 있는 로그인 수(구글 확인을 반복해 돌리는 것을 막음)

# ── 구글 로그인 ────────────────────────────────────────────────────────────────
# 로그인은 **선택**입니다. 검사는 로그인 없이 다 되고, 그때 기록은 그 브라우저에만 남습니다.
# 로그인하면 그 기록이 구글 계정으로 옮겨 가고, 다른 기기에서도 같은 계정으로 보입니다.
# 이 값이 비어 있으면 로그인 단추가 열리지 않습니다(검사는 그대로 됩니다).
# 받는 곳: console.cloud.google.com → Google 인증 플랫폼 → 클라이언트 → OAuth 클라이언트 ID
#          → 웹 애플리케이션 → '승인된 자바스크립트 원본'에 앱 주소를 넣습니다
#            (https://print-guard-ai.vercel.app, http://localhost:8752, http://127.0.0.1:8752)
#          리디렉션 URI는 필요 없습니다 — ID 토큰만 받는 방식이라 되돌아올 주소가 없습니다.
# 클라이언트 ID는 비밀이 아닙니다(브라우저가 화면에 들고 다니는 값). 그래도 코드에는 넣지 않습니다.
# 클라이언트 ID는 **비밀이 아닙니다** — 브라우저가 화면에 들고 다니는 값입니다.
# 받는 곳: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID
#          → 웹 애플리케이션 → '승인된 자바스크립트 원본'에 앱 주소를 넣습니다
#            (https://print-guard-ai.vercel.app, http://localhost:8752, http://127.0.0.1:8752)
#          리디렉션 URI는 필요 없습니다 — ID 토큰만 받는 방식이라 되돌아올 주소가 없습니다.
PG_GOOGLE_CLIENT_ID=
# PG_GOOGLE_CERTS=           # 구글 공개키 주소(테스트에서만 바꿉니다)

# ── MCP 서버를 주소로 열 때(기본은 stdio — 이 경우 아래는 필요 없습니다) ────────
# stdio는 클라이언트가 이 프로세스를 직접 띄우므로 띄운 사람이 주인이고, 인증이 없습니다.
# 주소로 열면 누가 부르는지 알 수 없으므로 Bearer 토큰을 요구하고, 토큰 없이는 뜨지 않습니다.
# 토큰은 `python -m pg_agents.mktoken --label <이름> [--write]` 로 미리 발급합니다.
# PG_MCP_TRANSPORT=stdio       # stdio | streamable-http | sse
# PG_MCP_PUBLIC_URL=           # 주소로 열 때 필수. 이 MCP 서버의 공개 주소
# PG_MCP_HOST=127.0.0.1
# PG_MCP_PORT=8710
# PG_TOKEN=                    # 이 MCP 서버가 **다른 PC**의 오케스트레이터를 부를 때 쓸 토큰
